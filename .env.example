# Copy to .env and fill in the values below. Keep this file private.
HF_TOKEN=
API_KEY=
ADMIN_API_KEY=

# Optional defaults. Leave these blank to start the controller with no model.
# Use absolute WSL paths, not /mnt/c paths.
LLAMA_SERVER=
HF_HOME=

# The first request downloads configured models if they are not already cached.
LLAMA_HF_REPO=
VLLM_MODEL=
VLLM_IMAGE=

# llama-swap listens here. Restrict the Windows firewall to the dev machine.
PORT=9292
MANAGE_PORT=9293
