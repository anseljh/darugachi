# Copy to .env and fill in the values below. Keep this file private.
HF_TOKEN=
API_KEY=
ADMIN_API_KEY=

# Absolute WSL paths, not /mnt/c paths.
LLAMA_SERVER=/home/you/llama.cpp/build/bin/llama-server
HF_HOME=/home/you/lan-model-server/hf-cache

# The first request downloads these models if they are not already cached.
LLAMA_HF_REPO=your-org/your-reranker-GGUF:Q4_K_M
VLLM_MODEL=intfloat/e5-small-v2
VLLM_IMAGE=vllm/vllm-openai:latest

# llama-swap listens here. Restrict the Windows firewall to the dev machine.
PORT=9292
MANAGE_PORT=9293
