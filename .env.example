# Copy to .env and fill in the values below. Keep this file private.
HF_TOKEN=
API_KEY=
ADMIN_API_KEY=

# Optional defaults. Leave these blank to start the controller with no model.
# Use absolute WSL paths, not /mnt/c paths.
LLAMA_SERVER=
HF_HOME=

# The first request downloads configured models if they are not already cached.
LLAMA_HF_REPO=
VLLM_MODEL=
VLLM_IMAGE=

# Fraction of the GPU vLLM reserves up front, before loading weights; it aborts
# if that much is not already free. vLLM's own default is 0.92, which assumes a
# dedicated card -- on this box ~1.4GiB is held by WSL2/display, so 0.92 of 8GiB
# asked for more than was free and a 596MB model failed to start. Defaults to
# 0.75 when blank. Raise it if the card is otherwise idle and a larger model
# needs the room; lower it if something else is resident.
VLLM_GPU_MEMORY_UTILIZATION=

# Longest sequence vLLM will size its KV cache for. Left unset, vLLM reads the
# config's position embeddings, which some 1B models set to 131072 -- more than
# an 8GB card can hold, and more than the model card claims the model supports
# (llama-nemotron-embed-vl-1b-v2 says 10240 and is served with exactly that).
# Defaults to 10240 when blank. This is a ceiling for the box; a model whose
# real limit is lower is unaffected.
VLLM_MAX_MODEL_LEN=

# llama-swap listens here. Restrict the Windows firewall to the dev machine.
PORT=9292
MANAGE_PORT=9293
